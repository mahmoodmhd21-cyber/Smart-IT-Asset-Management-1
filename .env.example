NODE_ENV=production
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/asset_management?replicaSet=smartit-rs
# Generate privately: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Explicit origin allowlist only if a separate frontend origin is required.
CORS_ORIGINS=
# Set to 1 only when exactly one trusted reverse proxy sits in front of Node.
TRUST_PROXY_HOPS=0
QR_PUBLIC_BASE_URL=https://assets.example.com
